# CORVUS — THE WATCHING CROW | Environment Configuration

# General
ENVIRONMENT=development
PROJECT_NAME="CORVUS — SatQuery AI"
API_V1_STR=/api/v1

# Backend FastAPI
HOST=0.0.0.0
PORT=8000
SECRET_KEY=corvus-secret-key-sih-2026-satquery-ai

# Database - PostgreSQL + PostGIS
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=corvus
POSTGRES_PASSWORD=corvus_password
POSTGRES_DB=corvus_db
DATABASE_URL=postgresql+asyncpg://corvus:corvus_password@localhost:5432/corvus_db

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=corvus-imagery
MINIO_USE_SSL=false

# Redis & Celery Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MongoDB Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=corvus_db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
